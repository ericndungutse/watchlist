# Runtime environment selects the matching database URI below.
# Use "production" in production deployments; local development can omit this
# because Next.js sets NODE_ENV=development automatically.
NODE_ENV=development

# MongoDB Connection URIs
MONGODB_URI_DEV=mongodb://localhost:27017/ent-tracker-dev
MONGODB_URI_PROD=mongodb://localhost:27017/ent-tracker-prod

# JWT Authentication Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
